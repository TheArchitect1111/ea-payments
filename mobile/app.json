{
  "expo": {
    "name": "Simplifi Orb",
    "slug": "simplifi-mobile",
    "owner": "efficiency-architects",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "simplifi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2B4D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.efficiencyarchitects.simplifi",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Simplifi to transcribe your voice into capture notes.",
        "NSMicrophoneUsageDescription": "Allow Simplifi to dictate notes for captures."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B2B4D"
      },
      "package": "com.efficiencyarchitects.simplifiorb",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Simplifi to analyze photos of opportunities.",
          "cameraPermission": "Allow Simplifi to capture photos of opportunities."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://efficiencyarchitects.online",
      "eas": {
        "projectId": "12870838-da3c-4900-a895-d6a7569e3e49"
      },
      "router": {}
    }
  }
}
