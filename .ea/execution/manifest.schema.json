{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efficiencyarchitects.online/schemas/execution-manifest.schema.json",
  "title": "EA Execution Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "job", "intent", "sourceOfTruth", "protectedInvariants", "activities", "gates", "verification", "completion"],
  "properties": {
    "version": { "const": "1.0.0" },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project", "deliverable", "mode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "deliverable": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["analysis", "implementation", "repair", "restore", "deployment"] }
      }
    },
    "intent": {
      "type": "object",
      "required": ["approved", "request"],
      "properties": {
        "approved": { "type": "boolean" },
        "request": { "type": "string", "minLength": 1 },
        "requiresNewAuthorization": { "type": "boolean", "default": false }
      }
    },
    "sourceOfTruth": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["kind", "reference"], "properties": { "kind": { "type": "string" }, "reference": { "type": "string" }, "revision": { "type": "string" } } }
    },
    "protectedInvariants": { "type": "array", "items": { "type": "string" } },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["id", "executor", "required"], "properties": { "id": { "type": "string" }, "executor": { "type": "string" }, "required": { "type": "boolean" }, "dependsOn": { "type": "array", "items": { "type": "string" } } } }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["id", "required", "onFail"], "properties": { "id": { "type": "string" }, "required": { "type": "boolean" }, "onFail": { "enum": ["repair", "rollback", "block"] }, "evidence": { "type": "string" } } }
    },
    "verification": {
      "type": "object",
      "required": ["productionRequired", "visualInspectionRequired", "functionalRequired"],
      "properties": {
        "productionRequired": { "type": "boolean" },
        "visualInspectionRequired": { "type": "boolean" },
        "functionalRequired": { "type": "boolean" },
        "routes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "completion": {
      "type": "object",
      "required": ["allowedStates", "forbidIfUnresolvedFailure"],
      "properties": {
        "allowedStates": { "type": "array", "items": { "enum": ["IMPLEMENTED", "DEPLOYED", "VERIFIED", "COMPLETE", "BLOCKED", "ROLLED_BACK"] } },
        "forbidIfUnresolvedFailure": { "const": true }
      }
    }
  }
}
