  "assemblyContract": {
    "selectionInput": "client manifest checkbox/module selection",
    "automaticOutputs": ["navigation-entry", "responsive-surface", "permissions", "data-bindings", "required-workflows", "required-integrations", "website-cta-binding-when-applicable", "acceptance-contract"],
    "unsupportedSelection": "fail-closed-and-route-to-capability-certification",
    "duplicateCapabilityImplementation": "forbidden-without-versioned-exception"
  },
  "certificationStates": ["DISCOVERED", "IMPLEMENTED", "CONTRACT_TESTED", "INTEGRATION_TESTED", "CERTIFIED", "DEPRECATED"],
  "run2ExitCriteria": [
    "master module catalog exists",
    "shared capability catalog exists",
    "common module compositions are explicit",
    "new clients select modules instead of requesting duplicate implementations",
    "production assembly may only consume CERTIFIED capability versions"
  ]
