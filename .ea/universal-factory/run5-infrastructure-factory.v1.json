{
  "schemaVersion":"1.0.0","program":"EA_UNIVERSAL_FACTORY_V1","run":5,"status":"ENFORCED_CONTRACT","component":"INFRASTRUCTURE_FACTORY",
  "purpose":"Turn a verified Run 4 project candidate into a reproducible, reviewable infrastructure plan and governed environment realization without destructive migration of existing EA production resources.",
  "iac":{"engine":"OpenTofu","mode":"DECLARATIVE_VERSIONED_REPRODUCIBLE","planBeforeApply":true,"stateRequired":true,"stateIsolation":"TENANT_AND_ENVIRONMENT","providerVersionsPinned":true,"moduleVersionsPinned":true},
  "entryGate":{"requiresRun4ProjectCandidate":true,"requiresTenantBinding":true,"requiresEnvironmentDeclaration":true,"requiresInfrastructureManifest":true,"requiresSecurityProfile":true,"requiresRecoveryPlan":true,"requiresCostBoundary":true},
  "environments":["development","preview","staging","production"],
  "lifecycle":["INGEST_PROJECT_CANDIDATE","RESOLVE_INFRASTRUCTURE_REQUIREMENTS","DISCOVER_EXISTING_RESOURCES","CLASSIFY_CREATE_ADOPT_OR_REFERENCE","GENERATE_IAC","VALIDATE_IAC","GENERATE_PLAN","POLICY_CHECK_PLAN","COST_CHECK_PLAN","SECURITY_CHECK_PLAN","APPLY_NON_PRODUCTION","VERIFY_NON_PRODUCTION","REQUEST_PRODUCTION_AUTHORIZATION","APPLY_AUTHORIZED_PRODUCTION","VERIFY_PRODUCTION","REGISTER_INFRASTRUCTURE_EVIDENCE"],
  "resourceClasses":["repository","deployment-project","domain","dns","database","object-storage","queue","email","identity","secrets-reference","monitoring","telemetry","feature-flags","workflow-runtime","integration-runtime"],
  "existingResourcePolicy":{"discoverBeforeCreate":true,"adoptOnlyWithExplicitIdentityMatch":true,"preserveExistingByDefault":true,"deleteExistingForbidden":true,"replaceExistingForbiddenWithoutExplicitMigrationApproval":true,"domainRepointForbiddenWithoutExplicitApproval":true,"sharedResourceMutationRequiresElevatedApproval":true},
  "productionPolicy":{"automaticProductionApply":false,"requiresExplicitProductionAuthorization":true,"requiresApprovedPlanHash":true,"requiresRollbackPlan":true,"requiresMonitoringReady":true,"requiresAcceptanceReady":true,"applyMustMatchApprovedPlan":true},
  "secretsPolicy":{"secretValuesInManifestForbidden":true,"secretValuesInRepositoryForbidden":true,"referencesOnly":true,"leastPrivilege":true,"rotationMetadataRequired":true},
  "drift":{"detect":true,"reconcile":"PLAN_THEN_POLICY_GATE","silentReconciliationForbidden":true,"unexpectedDestructiveDrift":"BLOCK_AND_ESCALATE"},
  "artifacts":{"outputs":["InfrastructureManifest","ExistingResourceInventory","IaCSource","ValidatedPlan","PlanHash","CostEvidence","SecurityEvidence","EnvironmentEvidence","RollbackEvidence","InfrastructureRegistryRecord"],"bindEveryArtifact":["tenantId","projectId","environment","manifestVersion","planHash"]},
  "failClosedOn":["unknown-existing-resource-ownership","cross-tenant-state","unversioned-provider","unversioned-module","destructive-plan-without-migration-approval","production-plan-without-authorization","plan-hash-mismatch","secret-in-source","missing-rollback-plan","missing-monitoring","shared-resource-mutation-without-elevated-approval","domain-repoint-without-approval"],
  "acceptanceCriteria":["same infrastructure manifest produces equivalent plan absent provider drift","existing resources are discovered before creation","state is tenant and environment isolated","production changes exactly match approved plan hash","no secret values are committed","rollback and monitoring exist before production","all realized infrastructure is registered with evidence"],
  "handoff":{"output":"GOVERNED_INFRASTRUCTURE_REALIZATION","nextRun":"RUN_6_CONNECTOR_FACTORY"}
}
