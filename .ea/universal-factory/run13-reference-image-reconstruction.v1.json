{
  "schemaVersion": "1.0.0",
  "program": "EA_UNIVERSAL_FACTORY_V1",
  "run": 13,
  "status": "ENFORCED_CONTRACT",
  "component": "REFERENCE_IMAGE_RECONSTRUCTION_ENGINE",
  "purpose": "Turn an approved website or portal reference image into a faithful responsive implementation before functional EA modules are wired, treating the reference as a visual specification rather than inspiration.",
  "sourceOfTruth": {
    "approvedReferenceImageIsVisualSpecification": true,
    "genericInterpretationForbidden": true,
    "goldenPathMayNotOverrideReferenceAppearance": true,
    "preserveApprovedComposition": ["layout-regions", "relative-proportions", "visual-hierarchy", "navigation-placement", "typography-hierarchy", "spacing-rhythm", "image-roles", "card-geometry", "borders-and-radius", "brand-expression"]
  },
  "entryGate": {
    "requiresApprovedReferenceImage": true,
    "requiresTargetExperienceType": true,
    "requiresTenantBinding": true,
    "requiresRun4AssemblyCandidate": true,
    "requiresRun7CustomExperienceContract": true
  },
  "reconstructionLifecycle": [
    "INGEST_APPROVED_REFERENCE",
    "NORMALIZE_REFERENCE_VIEWPORT",
    "DECOMPOSE_VISUAL_REGIONS",
    "EXTRACT_LAYOUT_GRAPH",
    "EXTRACT_VISUAL_DNA",
    "IDENTIFY_ASSET_ROLES",
    "MATCH_EA_COMPONENT_PRIMITIVES",
    "RECONSTRUCT_RESPONSIVE_CHASSIS",
    "MAP_CERTIFIED_LEGO_MODULES_TO_REFERENCE_REGIONS",
    "RENDER_CANDIDATE",
    "EMIT_RECONSTRUCTION_CANDIDATE_FOR_RUN14"
  ],
  "engines": {
    "visualDecomposition": ["BiRefNet_or_SAM2"],
    "assetPreparation": ["IC-Light", "Depth_Anything_V2_Small", "Real-ESRGAN", "ComfyUI"],
    "implementation": ["React", "Tailwind", "EA_DESIGN_SYSTEM"],
    "verification": ["Playwright", "visual-regression", "responsive-checks"]
  },
  "moduleMapping": {
    "principle": "Function follows the approved visual composition. Certified EA Lego modules are inserted into the reconstructed regions without replacing the approved appearance with default module chrome.",
    "preserveModuleBehavior": true,
    "permitVisualSkinning": true,
    "permitLayoutAdaptation": true,
    "defaultDashboardFallbackForbiddenWhenReferenceExists": true
  },
  "tb3Benchmark": {
    "reference": "TB3 HQ approved portal design",
    "requiredRegions": ["TB3-brand-header", "athlete-hero", "left-navigation", "featured-video", "progress-and-focus", "upcoming", "opportunities", "recent-media", "messages", "eva", "store", "footer"],
    "failureExample": "A generic light dashboard containing equivalent menu labels or cards does not satisfy the approved TB3 reference and must fail reconstruction acceptance."
  },
  "failClosedOn": [
    "generic-template-output",
    "reference-layout-not-reconstructed",
    "approved-region-missing",
    "golden-path-appearance-substitution",
    "default-dashboard-fallback",
    "unapproved-brand-substitution",
    "module-functionality-replacing-reference-composition"
  ],
  "artifacts": {
    "outputs": ["ReferenceSpecification", "VisualRegionMap", "LayoutGraph", "VisualDNA", "AssetRoleMap", "ModuleRegionMap", "ResponsiveChassis", "ReconstructionCandidate"]
  },
  "acceptanceCriteria": [
    "candidate is recognizably the approved reference before reading labels",
    "major reference regions and their hierarchy are preserved",
    "EA Lego functionality is mapped into the reference composition rather than replacing it",
    "generic dashboard fallback cannot pass when a reference image exists",
    "desktop reconstruction is ready for measured visual comparison",
    "responsive rules are derived from the reconstructed hierarchy",
    "candidate is handed to Run 14 for render-diff-correct iteration"
  ],
  "handoff": {
    "output": "REFERENCE_RECONSTRUCTION_CANDIDATE",
    "nextRun": "RUN_14_VISUAL_FEEDBACK_LOOP",
    "productionReady": false
  }
}
