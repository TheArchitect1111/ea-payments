import { test } from 'node:test';
import assert from 'node:assert/strict';
import { build } from 'esbuild';
import { resolve } from 'node:path';
import { readFileSync } from 'node:fs';
import { NextRequest } from 'next/server.js';
const root = process.cwd();
const db = { records: new Map<string, any>(), entitlements: [] as any[], writes: [] as string[], durable: true, dropped: false, confirmations: 0, session: null as any, member: true, payment: null as any };
(globalThis as any).__chassisTest = db;
const mocks: Record<string, string> = {
  '@/lib/creative-studio/persistence': `
    const db=()=>globalThis.__chassisTest;
    export async function saveStudioRecord(row){db().writes.push(row.id); if(db().durable)db().records.set(row.recordType+':'+row.id,structuredClone(row.payload));return {ok:true,persistedToAirtable:db().durable};}
    export async function loadStudioRecordFromAirtable(type,id){return structuredClone(db().records.get(type+':'+id)??null);}
    export const loadStudioRecord=loadStudioRecordFromAirtable;
  `,
  '@/lib/entitlements': `
    const db=()=>globalThis.__chassisTest;
    export async function listEntitlementsForOrg(org){return db().entitlements.filter(e=>e.organizationId===org);}
    export function activeModuleIdsFromEntitlements(rows){return new Set(rows.filter(e=>e.status==='active'||e.status==='trial').map(e=>e.moduleId));}
    export async function setModuleEnabled(org,moduleId,enabled,source){const e={organizationId:org,moduleId,status:enabled?'active':'suspended',source};globalThis.__chassisTest.entitlements=globalThis.__chassisTest.entitlements.filter(x=>x.organizationId!==org||x.moduleId!==moduleId);globalThis.__chassisTest.entitlements.push(e);globalThis.__chassisTest.writes.push('entitlement');return e;}
    export async function setModulesEnabledBulk(org,ids,enabled,source){for(const id of ids)await setModuleEnabled(org,id,enabled,source);return {ok:ids,failed:[]};}
    export async function syncPackageEntitlements(org,ids){db().writes.push('entitlements');if(db().dropped)return;db().entitlements=db().entitlements.filter(e=>e.organizationId!==org||e.source!=='package');for(const id of ids)db().entitlements.push({organizationId:org,moduleId:id,status:'active',source:'package'});}
  `,
  '@/lib/organizations': `
    export async function ensureOrganizationForPortal(){globalThis.__chassisTest.writes.push('org');return {orgId:'recTENANT1'};}
    export async function findOrganizationByPortalSlug(slug){return {id:'recTENANT1',portalSlug:slug,status:'Active'};}
    export async function updateOrganizationWorkspaceConfig(org,config){globalThis.__chassisTest.records.set('brand:org-workspace-'+org,structuredClone(config));return config;}
  `,
  '@/lib/admin-session-guard': `export async function requireAdminActionFromRequest(){return {ok:true};}export async function requireAdminSessionFromRequest(){return {ok:true};}export function adminAuthJsonError(){return Response.json({error:'Denied'},{status:403});}`,
  '@/lib/platform-store': `export function platformStoreConfigured(){return true;}`,
  '@/lib/tenant-context': `export function isSyntheticOrganizationId(org){return org.startsWith('org_');}`,
  '@/lib/api/portal-route': `export async function guardPortalApi(req,{slug}){const session=globalThis.__chassisTest.session;return session&&session.slug===slug?{ok:true,session}:{ok:false,status:401,error:'Authentication required'};}export function portalApiUnauthorized(f){return Response.json({error:f.error},{status:f.status});}`,
  '@/lib/memberships': `export async function findMembership(){return globalThis.__chassisTest.member?{status:'active',role:'viewer'}:null;}`,
  '@/lib/stripe': `export function getStripe(){return {paymentIntents:{retrieve:async()=>globalThis.__chassisTest.payment},checkout:{sessions:{create:async()=>({id:'cs_test',url:'https://checkout.stripe.com/test'})}}};}`,
  '@/lib/ea-auth-email': `export async function sendAuthEmail(){globalThis.__chassisTest.confirmations++;return {ok:true};}`,
  '@/lib/os-capability-taxonomy': 'export function listOsCapabilitiesByLifecycle(){return [];}',
};
const compiled = await build({ stdin: { contents: `export * from './lib/tenant-foundation'; export * from './lib/modules/ensure-package-entitlements';export * from './lib/modules/client-factory-assembly';export * from './lib/portal-universal/bricks/amanda';export { POST as brickPOST } from './app/api/portal/[slug]/bricks/amanda/route';export * from './lib/portal-universal/bricks/amanda/stripe';export { POST as entitlementsPOST } from './app/api/admin/entitlements/route';`, resolveDir: root },
  bundle: true, write: false, platform: 'node', format: 'esm', packages: 'external', plugins: [{ name: 'ports', setup(b) {
    b.onResolve({ filter: /.*/ }, args => mocks[args.path] ? { path: args.path, namespace: 'ports' } : undefined);
    b.onLoad({ filter: /.*/, namespace: 'ports' }, args => ({ contents: mocks[args.path], loader: 'js' }));
  }}] });
// packages external need the module to resolve from this repository, not a data URL.
const { writeFile, unlink } = await import('node:fs/promises');
const artifact = resolve(root, 'tests/.chassis-autowire-bundle.mjs');
await writeFile(artifact, compiled.outputFiles[0].text);
const api = await import(artifact);
await unlink(artifact);
function reset(){db.records.clear();db.entitlements=[];db.writes=[];db.durable=true;db.dropped=false;db.confirmations=0;db.session=null;db.member=true;db.payment=null;}
const base={portalSlug:'new-academy',clientName:'New Academy',packagePurchased:'Launch Verification',assemblyMode:'certified' as const};
const config={brandName:'New Academy',confirmationSubject:'Registered: {{class_name}}',confirmationHtml:'Hello {{first_name}}: {{class_name}}',offers:[{id:'lesson',title:'Lesson',amount:100,currency:'cad'}]};
const tenant={organizationId:'recTENANT1',portalSlug:'new-academy'};
async function install(){return api.ensureTenantFoundation({...base,bricks:[{id:'amanda',config}]});}
test('route-render: selected adapter is installed and its API routes exist',async()=>{reset();const result=await install();assert.equal(result.orgId,tenant.organizationId);assert.deepEqual(await api.loadAmandaInstall(tenant),config);for(const p of ['app/api/admin/chassis/install/route.ts','app/api/portal/[slug]/bricks/amanda/route.ts'])assert.match(readFileSync(resolve(root,p),'utf8'),/export async function POST/);});
test('responsive-ui: composite uses existing responsive modules without replacing Amanda UI',()=>{const s=readFileSync('lib/portal-universal/bricks/amanda/index.ts','utf8');assert.match(s,/AMANDA_BRICK_MODULES/);const source=readFileSync('app/api/portal/[slug]/bricks/amanda/route.ts','utf8');assert.match(source,/guardPortalApi/);});
test('authorization-tenant-isolation: no synthetic tenant or cross-tenant registration',async()=>{reset();await install();const row=await api.signupAmandaBrick(tenant,{email:'student@example.com',name:'Student',offerId:'lesson'});await assert.rejects(api.readAmandaRegistration({...tenant,organizationId:'recOTHER'},row.registration_id));await assert.rejects(api.installAmandaBrick({...tenant,organizationId:'org_fake'},config));});
test('durable-persistence: admitted selection equals written entitlements and survives package backfill',async()=>{reset();const result=await api.ensureTenantFoundation({...base,requestedModuleIds:['connect','connect'],businessOptionIds:['forms-intake-applications']});const admitted=result.assemblyEvidence.admitted;assert.deepEqual(new Set(db.entitlements.map(e=>e.moduleId)),new Set(admitted));assert.ok(admitted.includes('connect'));await api.ensurePackageEntitlements({orgId:tenant.organizationId,slug:tenant.portalSlug,packagePurchased:'Launch Verification'});assert.deepEqual(new Set(db.entitlements.map(e=>e.moduleId)),new Set(admitted));});
test('dependency-integration-readiness: offer key, bundle, pack and unknown selections share preflight',()=>{reset();const plan=api.requireClientFactoryAssembly({...base,commerceOfferId:'website_portal_starter'});assert.ok(plan.admitted.includes('billing'));assert.throws(()=>api.requireClientFactoryAssembly({...base,businessOptionIds:['people-directory']}),/people/);assert.throws(()=>api.requireClientFactoryAssembly({...base,industryPackId:'online-academy-student-portal'}),/calendar|people/);assert.throws(()=>api.requireClientFactoryAssembly({...base,industryPackId:'missing'}));assert.throws(()=>api.requireClientFactoryAssembly({...base,requestedModuleIds:['missing']}));assert.equal(db.writes.length,0);});
test('success-empty-failure-states: nondurable or dropped writes never produce successful install',async()=>{reset();db.durable=false;await assert.rejects(install(),/durably/);reset();db.dropped=true;await assert.rejects(install(),/read-back/);});
test('observability: receipt, install manifest and signup/paid tracking events are retained',async()=>{reset();await install();const row=await api.signupAmandaBrick(tenant,{email:'student@example.com',name:'Student',offerId:'lesson'});assert.ok(db.writes.some(x=>x.startsWith('assembly-evidence-')));assert.ok(db.writes.includes('enrollment-signup-'+row.registration_id));});
test('rollback-disable: blocked manifests write nothing and failed installs remain incomplete',async()=>{reset();await assert.rejects(api.ensureTenantFoundation({...base,requestedModuleIds:['people']}));assert.deepEqual(db.writes,[]);reset();db.dropped=true;await assert.rejects(install());const journal=[...db.records.values()].find(r=>r.brickIds);assert.equal(journal.state,'installing');});
test('business-lifecycle: verified payment updates same registration; replay has one confirmation',async()=>{reset();await install();const row=await api.signupAmandaBrick(tenant,{email:'student@example.com',name:'<Student>',offerId:'lesson'});const ports={verify:async(reference:string)=>({reference,organizationId:tenant.organizationId,registrationId:row.registration_id,offerId:'lesson',amount:100,currency:'cad',paid:true}),confirm:async(message:any)=>{db.confirmations++;assert.match(message.html,/&lt;Student&gt;/);}};await assert.rejects(api.payAmandaBrick(tenant,row.registration_id,'pi_wrong',{...ports,verify:async(reference:string)=>({...await ports.verify(reference),amount:999})}));assert.equal((await api.readAmandaRegistration(tenant,row.registration_id)).payment_status,'unpaid');await api.payAmandaBrick(tenant,row.registration_id,'pi_test',ports);await api.payAmandaBrick(tenant,row.registration_id,'pi_test',ports);const again=await api.signupAmandaBrick(tenant,{email:'student@example.com',name:'Student',offerId:'lesson'});assert.equal(again.payment_status,'paid');assert.equal(again.payment_reference,'pi_test');assert.equal(db.confirmations,1);assert.equal([...db.records.keys()].filter(k=>/^experience:enrollment-[a-f0-9]{64}$/.test(k)).length,1);await assert.rejects(api.payAmandaBrick(tenant,row.registration_id,'pi_other',ports),/Conflicting/);});
test('immutable-version-fingerprint: original client files are outside portable adapter',()=>{assert.match(readFileSync('lib/portal-universal/bricks/registry.ts','utf8'),/version: 1/);assert.match(readFileSync('lib/amanda-catherine/preview-dollar-test.ts','utf8'),/STRIPE_TEST_SECRET_KEY/);});

const request=(data:any,origin='https://example.com')=>new NextRequest('https://example.com/api/portal/new-academy/bricks/amanda',{method:'POST',headers:{'Content-Type':'application/json',origin},body:JSON.stringify(data)});
const context={params:Promise.resolve({slug:'new-academy'})};
test('API denies unauthenticated, wrong tenant, missing membership and cross-origin requests',async()=>{reset();await install();assert.equal((await api.brickPOST(request({action:'signup',name:'Student',offerId:'lesson'}),context)).status,401);db.session={slug:'new-academy',orgId:'recOTHER',role:'viewer',email:'student@example.com'};assert.equal((await api.brickPOST(request({action:'signup',name:'Student',offerId:'lesson'}),context)).status,403);db.session.orgId=tenant.organizationId;db.member=false;assert.equal((await api.brickPOST(request({action:'signup',name:'Student',offerId:'lesson'}),context)).status,403);db.member=true;assert.equal((await api.brickPOST(request({action:'signup',name:'Student',offerId:'lesson'},'https://evil.example'),context)).status,403);});
test('authenticated API signup, checkout and signed-callback fulfillment use installed adapter',async()=>{reset();await install();db.session={slug:'new-academy',orgId:tenant.organizationId,role:'viewer',email:'student@example.com'};const response=await api.brickPOST(request({action:'signup',name:'Student',offerId:'lesson'}),context);assert.equal(response.status,200);const {registration}=await response.json();assert.equal((await api.brickPOST(request({action:'checkout',registrationId:registration.registration_id}),context)).status,200);db.payment={id:'pi_test',metadata:{organizationId:tenant.organizationId,registrationId:registration.registration_id,offerId:'lesson'},amount_received:100,currency:'cad',status:'succeeded'};assert.equal(await api.fulfillPortableAmandaSession({metadata:{portableBrick:'amanda',organizationId:tenant.organizationId,portalSlug:tenant.portalSlug,registrationId:registration.registration_id},payment_intent:'pi_test',payment_status:'paid'}),true);assert.equal((await api.readAmandaRegistration(tenant,registration.registration_id)).payment_status,'paid');db.entitlements=db.entitlements.filter(e=>e.moduleId!=='billing');await assert.rejects(api.fulfillPortableAmandaPayment(tenant,registration.registration_id,'pi_test'),/unavailable/);});
test('positive industry pack selection is persisted with admitted modules',async()=>{reset();const result=await api.ensureTenantFoundation({...base,industryPackId:'website-portal'});const row=[...db.records.values()].find(x=>x.brickIds);assert.equal(row.industryPackId,'website-portal');assert.equal(row.state,'installed');assert.deepEqual(new Set(row.admitted),new Set(result.assemblyEvidence.admitted));});

test('admin selector rejects uncertified and unknown selections before writes',async()=>{reset();for(const body of [{action:'set',moduleId:'people'},{action:'set-business-option',businessOptionId:'online-academy-student-portal'},{action:'bulk-enable',moduleIds:['connect','typo']}]){const result=await api.entitlementsPOST(request({organizationId:tenant.organizationId,...body}));assert.ok([400,409].includes(result.status));assert.equal(db.writes.length,0);}const response=await api.entitlementsPOST(request({organizationId:tenant.organizationId,action:'set-business-option',businessOptionId:'forms-intake-applications'}));assert.equal(response.status,200);const result=await response.json();assert.deepEqual(new Set(result.updated),new Set(['dashboard','amplifi','update-hub','intake','applications']));});

test('selector changes remain installed across later backfill and disable is retained',async()=>{reset();await install();let response=await api.entitlementsPOST(request({organizationId:tenant.organizationId,action:'set',moduleId:'connect',enabled:true}));assert.equal(response.status,200);await api.ensurePackageEntitlements({orgId:tenant.organizationId,slug:tenant.portalSlug,packagePurchased:'Launch Verification'});assert.ok(db.entitlements.some(e=>e.moduleId==='connect'&&e.status==='active'));response=await api.entitlementsPOST(request({organizationId:tenant.organizationId,action:'set',moduleId:'connect',enabled:false}));assert.equal(response.status,200);await api.ensurePackageEntitlements({orgId:tenant.organizationId,slug:tenant.portalSlug,packagePurchased:'Launch Verification'});assert.ok(!db.entitlements.some(e=>e.moduleId==='connect'&&e.status==='active'));assert.equal((await api.entitlementsPOST(request({organizationId:tenant.organizationId,action:'set',moduleId:'dashboard',enabled:false}))).status,409);});
