# Commercial TEST certification environment (Version 1)
# Copy to .env.test.local in the repo root and fill Stripe TEST + Resend values.
# NEVER put sk_live / pk_live here. Cert scripts refuse LIVE keys.

# ── Stripe TEST (required) ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
# Local-only webhook secret is fine for cert (generate via bootstrap script).
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
# Optional — inline price_data is used when unset (website_portal_starter allows it).
# STRIPE_PRICE_WEBSITE_PORTAL_STARTER=price_test_REPLACE

# ── Resend (required for welcome email proof) ────────────────────────
RESEND_API_KEY=re_REPLACE
RESEND_FROM_EMAIL=EA Cert <onboarding@resend.dev>

# ── Shared platform (usually copied from .env.local) ─────────────────
AIRTABLE_API_KEY=
AIRTABLE_PAYMENTS_BASE_ID=
AIRTABLE_PLATFORM_BASE_ID=
SESSION_SECRET=
ADMIN_SESSION_SECRET=
SUPPORT_EMAIL=freedom@efficiencyarchitects.online

# ── Cert runtime ─────────────────────────────────────────────────────
EA_COMMERCIAL_CERT_MODE=test
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CERT_BASE_URL=http://localhost:3000
# Never set this unless you intentionally webhook against production with sk_test:
# EA_ALLOW_TEST_AGAINST_PROD=1
