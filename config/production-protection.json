{
  "version": 3,
  "clients": [
    {
      "id": "ea-platform",
      "name": "Efficiency Architects Platform",
      "publicUrls": [
        "https://efficiencyarchitects.online/"
      ],
      "platformRoutes": [
        "/portal/login",
        "/amplifi"
      ],
      "protectedSourceFiles": [
        "lib/canonical-project-registry.ts",
        "ECOSYSTEM-MAP.md",
        "SECURITY-MODEL.md",
        "DEPLOYMENT-REGISTRY.md"
      ],
      "sourceContracts": [
        {
          "path": "lib/canonical-project-registry.ts",
          "mustContain": [
            "EA-PLATFORM",
            "https://efficiencyarchitects.online",
            "TheArchitect1111/ea-payments",
            "ea-payments"
          ]
        },
        {
          "path": "SECURITY-MODEL.md",
          "mustContain": [
            "Missing or malformed roles resolve to no privilege",
            "Privileged tenant operations require a persisted organization ID",
            "Client-supplied tenant IDs must be ignored or checked against the authenticated session"
          ]
        },
        {
          "path": "DEPLOYMENT-REGISTRY.md",
          "mustContain": [
            "TheArchitect1111/ea-payments",
            "Default branch",
            "master",
            "Vercel project",
            "ea-payments"
          ]
        }
      ]
    },
    {
      "id": "amplifi",
      "name": "Amplifi by Efficiency Architects",
      "publicUrls": [
        "https://efficiencyarchitects.online/amplifi"
      ],
      "platformRoutes": [
        "/amplifi",
        "/amplifi/workspace"
      ],
      "protectedSourceFiles": [
        "app/amplifi/page.tsx",
        "lib/canonical-project-registry.ts"
      ],
      "sourceContracts": [
        {
          "path": "app/amplifi/page.tsx",
          "mustContain": [
            "Amplifi"
          ]
        },
        {
          "path": "lib/canonical-project-registry.ts",
          "mustContain": [
            "AMPLIFI",
            "https://efficiencyarchitects.online/amplifi",
            "app/amplifi",
            "ea-payments"
          ]
        }
      ]
    },
    {
      "id": "amanda-catherine",
      "name": "Amanda Catherine",
      "publicUrls": [
        "https://amandacatherine.ca/",
        "https://www.amandacatherine.ca/"
      ],
      "platformRoutes": [
        "/portal/amanda-catherine",
        "/portal/amanda-catherine/enroll",
        "/portal/amanda-catherine/learning",
        "/portal/login?next=/portal/amanda-catherine"
      ],
      "healthEndpoint": "/api/health/amanda-login",
      "requiredHealthChecks": [
        "authenticatedOwnerRoute",
        "authenticatedPortalHome",
        "authenticatedMemberRoute",
        "premiumOwnerDashboard",
        "allMenuRoutes",
        "allCourseResourceRoutes",
        "entrepreneurialArtistPlaylistConfigured"
      ],
      "requiredOwnerMarkers": [
        "Owner portal",
        "Quick Actions",
        "Ask Eva",
        "Business Overview"
      ],
      "protectedSourceFiles": [
        "clients/amanda-catherine/client.json",
        "clients/amanda-catherine/assets.json",
        "lib/canonical-project-registry.ts",
        "app/portal/amanda/page.tsx",
        "app/portal/amanda-catherine/page.tsx",
        "app/portal/[slug]/member/AmandaMemberHome.tsx",
        "app/portal/[slug]/member/AmandaOwnerDashboard.module.css",
        "lib/amanda-catherine/course-resources.ts"
      ],
      "sourceContracts": [
        {
          "path": "clients/amanda-catherine/client.json",
          "mustContain": [
            "TheArchitect1111/ea-payments",
            "clients/amanda-catherine",
            "https://amandacatherine.ca",
            "/portal/amanda-catherine",
            "amanda-catherine-4",
            "ea-payments",
            "amanda-catherine-preview",
            "retiredVercelProjects"
          ]
        },
        {
          "path": "clients/amanda-catherine/assets.json",
          "mustContain": [
            "public/amanda-catherine",
            "lib/amanda-catherine/course-resources.ts",
            "vercel-blob",
            "authoritative Amanda asset map"
          ]
        },
        {
          "path": "lib/canonical-project-registry.ts",
          "mustContain": [
            "clients/amanda-catherine",
            "amanda-catherine-4",
            "The only portal is /portal/amanda-catherine",
            "retired historical Vercel projects"
          ],
          "mustNotContain": [
            "vercelProjects: ['amanda-catherine-preview', 'ea-payments']",
            "The website and portal are separate production surfaces"
          ]
        },
        {
          "path": "app/portal/amanda/page.tsx",
          "mustContain": [
            "redirect('/portal/amanda-catherine')"
          ]
        },
        {
          "path": "app/portal/amanda-catherine/page.tsx",
          "mustContain": [
            "if (isAdministrator)",
            "<AmandaMemberHome",
            "complete branded shell"
          ],
          "mustNotContain": [
            "<PortalShell"
          ]
        },
        {
          "path": "app/portal/[slug]/member/AmandaMemberHome.tsx",
          "mustContain": [
            "styles.shell",
            "Owner portal",
            "Quick Actions",
            "Ask Eva",
            "Business Overview",
            "aesthetikine-studio-hero.jpg"
          ]
        },
        {
          "path": "app/portal/[slug]/member/AmandaOwnerDashboard.module.css",
          "mustContain": [
            ".shell",
            ".sidebar",
            ".hero",
            ".mobileNav"
          ]
        },
        {
          "path": "lib/amanda-catherine/course-resources.ts",
          "mustContain": [
            "reset-training-manual",
            "body-sculpt-certification-overview",
            "body-sculpt-textbook",
            "body-sculpt-video-demo"
          ]
        }
      ]
    }
  ]
}
